# ─── App ───────────────────────────────────────────────────────────────────────
APP_NAME=VoxClone
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — no extra setup needed)
DATABASE_URL=sqlite+aiosqlite:///./voxclone.db

# PostgreSQL (future support — uncomment and set when migrating)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/voxclone

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
LOGS_DIR=logs

# Maximum upload size in bytes (default: 2 GB)
MAX_UPLOAD_SIZE_BYTES=2147483648

# ─── FFmpeg ────────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ─── Whisper (whisper.cpp — CPU-only, no Python ML dependencies) ───────────────
# Name on PATH, or absolute path to the compiled whisper-cli binary.
# After building whisper.cpp: make -j  → produces ./build/bin/whisper-cli
# or add the build directory to PATH and leave this as "whisper-cli".
WHISPER_CPP_BINARY=whisper-cli

# Path to the GGML model file used as a global fallback when no per-job model is set.
# Per-job overrides: POST /jobs parameters.whisper_model = tiny | base | small
# Job-type defaults (when whisper_model omitted):
#   subtitle_generation → tiny
#   karaoke             → base
# Supported models for CPU-only / offline use:
#   models/ggml-tiny.en.bin    ~75 MB   fastest
#   models/ggml-base.en.bin   ~142 MB   good balance  (recommended)
#   models/ggml-small.en.bin  ~466 MB   highest accuracy
# Download: see docs/testing/WHISPER_CPP_SETUP.md
WHISPER_MODEL_PATH=models/ggml-tiny.en.bin

# CPU thread count. Rule of thumb: physical core count, max 8.
# On a 32 GB RAM machine with 8 cores: WHISPER_THREADS=8
WHISPER_THREADS=4

# Language hint passed to whisper.cpp (-l flag).
# Use "en" for the .en English-only models (tiny.en, base.en, small.en).
# Leave empty to let whisper.cpp auto-detect (not recommended for .en models).
WHISPER_LANGUAGE=en

# ─── Source separation (Demucs — Phase 5) ─────────────────────────────────────
# CPU-only default; GPU workers may set DEMUCS_DEVICE=cuda
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cpu
SEPARATION_SAMPLE_RATE=44100
SEPARATION_CHANNELS=2

# ─── Audio enhancement (DeepFilterNet deep-filter CLI — Phase 6) ───────────────
# NOT a pip package — subprocess only. See docs/reports/PHASE6_DEPENDENCY_PROTECTION_RULES.md
# Example: tools/experiments/bin/deep-filter (after PoC download) or system PATH name
DEEPFILTER_BINARY=deep-filter
ENHANCEMENT_SAMPLE_RATE=48000
ENHANCEMENT_CHANNELS=1

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
ALLOWED_ORIGINS=*

# ─── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FORMAT=json
