# ─── App ───────────────────────────────────────────────────────────────────────
APP_NAME=VoxClone
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — no extra setup needed)
DATABASE_URL=sqlite+aiosqlite:///./voxclone.db

# PostgreSQL (future support — uncomment and set when migrating)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/voxclone

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
LOGS_DIR=logs

# Maximum upload size in bytes (default: 2 GB)
MAX_UPLOAD_SIZE_BYTES=2147483648

# ─── FFmpeg ────────────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all
ALLOWED_ORIGINS=*

# ─── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FORMAT=json
